# This fragment is sourced from zshenv. Ignore it for non-interactive shells.
[[ ${-} = ${-/i/} ]] && return

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias cl="clear"
alias l="eza -la --icons --git --sort type"
alias lt="l --tree --level=2 --long"
alias la="eza --tree"
alias tp="btop"
alias lz="lazygit"
alias v="nvim"
alias x="exit"
if (( ! ${+aliases[ul]} && ! ${+functions[ul]} )); then
  alias ul=userland
fi

_fselect() { fd "$@" 2>/dev/null | fzf --height 40% --reverse --preview 'rg --context 2 --color always . {} | head -100' --query "${@: -1}"; }
cx() { cd "$@" && l; }
mkcd() { mkdir -p "$1" && cd "$1"; }
klp() { for p in "$@"; do lsof -ti ":$p" | xargs kill -9 2>/dev/null && echo "killed port $p" || echo "no process on port $p"; done; }

bindkey jj vi-cmd-mode

# Userland generates this file during sync. Shell startup reads static text and
# never invokes completion generators, Homebrew, or mise activation hooks.
if [ -r "${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/init.zsh" ]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/init.zsh"
fi

# Recover Starship if an older or incomplete cache predates the installed tool.
if (( $+commands[starship] )) && [[ -z ${_userland_starship_loaded:-} ]]; then
  eval "$(starship init zsh)"
fi
unset _userland_starship_loaded
