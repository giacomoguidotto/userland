#!/usr/bin/env bash
# Non-interactive authentication operations. Userland's TUI owns the wizard,
# its stage instructions and prompts; this helper never reads terminal input.
set -euo pipefail

agent_ready() {
  local candidate
  for candidate in "${SSH_AUTH_SOCK:-}" \
    "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" \
    "$HOME/.1password/agent.sock"; do
    [[ -n "$candidate" && -S "$candidate" ]] && return 0
  done
  return 1
}
ssh_ready() {
  { ssh -o BatchMode=yes -o ConnectTimeout=8 -T life-github 2>&1 || true; } |
    grep -q 'successfully authenticated'
}
gh_plaintext() {
  local hosts="${XDG_CONFIG_HOME:-$HOME/.config}/gh/hosts.yml"
  [[ -f "$hosts" ]] && grep -Eq '^[[:space:]]+oauth_token:' "$hosts"
}
check_stage() {
  case "$1" in
    agent) agent_ready ;;
    ssh) ssh_ready ;;
    github-cli) gh auth status --hostname github.com >/dev/null 2>&1 && ! gh_plaintext ;;
    codex) codex login status >/dev/null 2>&1 && [[ ! -e "$HOME/.codex/auth.json" ]] ;;
    *) return 1 ;;
  esac
}
apply_stage() {
  case "$1" in
    agent) open -a '1Password' ;;
    ssh)
      pbcopy <"$HOME/.ssh/life-auth.pub"
      open 'https://github.com/settings/ssh/new'
      ;;
    github-cli)
      if gh_plaintext; then gh auth logout --hostname github.com </dev/null; fi
      gh auth login --hostname github.com --git-protocol https --web
      if gh_plaintext; then
        gh auth logout --hostname github.com </dev/null || return 1
        printf '%s\n' 'GitHub CLI could not store the login in the keyring; login was removed.' >&2
        return 1
      fi
      ;;
    codex)
      # Replace only the old plaintext credential cache; managed config requires keyring storage.
      rm -f "$HOME/.codex/auth.json"
      codex login
      if [[ -e "$HOME/.codex/auth.json" ]]; then
        printf '%s\n' 'Codex wrote auth.json despite the keyring policy; setup is incomplete.' >&2
        return 1
      fi
      ;;
    *) return 1 ;;
  esac
}

case "${1:-}" in
  --check-stage) check_stage "${2:-}" ;;
  --apply-stage) apply_stage "${2:-}" ;;
  --check)
    missing=()
    for stage in agent ssh github-cli codex; do
      check_stage "$stage" || missing+=("$stage")
    done
    if (( ${#missing[@]} )); then
      printf 'personal authentication needs setup: %s\n' "${missing[*]}"
      exit 1
    fi
    ;;
  *)
    printf '%s\n' 'Run userland sync to complete authentication in the Userland TUI.' >&2
    exit 2
    ;;
esac
