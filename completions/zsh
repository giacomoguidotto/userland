#compdef userland

_userland() {
  local -a commands
  commands=(
    'plan:Preview what would change'
    'sync:Update, apply, and verify declared state'
    'doctor:Check drift and machine health'
    'realm:Attach or detach private configuration'
    'completions:Print shell completions'
    'help:Show command help'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case ${words[2]} in
    doctor) _arguments '1:option:(--json)' ;;
    realm)
      if (( CURRENT == 3 )); then
        _arguments '1:action:(add remove)'
      elif [[ ${words[3]} == add ]]; then
        _arguments '2:repository:' '3:mount path:_directories'
      elif [[ ${words[3]} == remove ]]; then
        _arguments '2:name or mount path:_directories'
      fi
      ;;
    completions) _arguments '1:shell:(bash fish nushell zsh)' ;;
  esac
}

compdef _userland userland
if (( ${+aliases[ul]} )) && [[ ${aliases[ul]} == userland ]]; then
  compdef _userland ul
fi
