#!/usr/bin/env bash
# Non-interactive authentication operations. Userland's TUI owns the wizard,
# its stage instructions and prompts; this helper never reads terminal input.
set -euo pipefail

agent_socket() {
  local candidate
  for candidate in "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" \
    "$HOME/.1password/agent.sock" "${SSH_AUTH_SOCK:-}"; do
    if [[ -n "$candidate" && -S "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}
agent_ready() {
  agent_socket >/dev/null
}
ssh_ready() {
  local socket output
  socket=$(agent_socket) || { printf '%s\n' '1Password SSH agent socket is unavailable.'; return 1; }
  output=$(SSH_AUTH_SOCK="$socket" ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=8 -T life-github 2>&1) || true
  if [[ "$output" == *"Hi giacomoguidotto! You've successfully authenticated"* ]]; then return 0; fi
  printf '%s\n' "$output"
  return 1
}
# Registration is public state and does not require a GitHub CLI login. A
# failed lookup is unknown, never evidence that the key needs to be added.
ssh_registration() {
  local key page response found count
  key=$(awk 'NF >= 2 { print $1 " " $2; exit }' "$HOME/.ssh/life-auth.pub") || return 2
  [[ -n "$key" ]] || return 2
  for ((page=1; page<=100; page++)); do
    response=$(curl -q -fsS --connect-timeout 5 --max-time 10 \
      -H 'Accept: application/vnd.github+json' \
      "https://api.github.com/users/giacomoguidotto/keys?per_page=100&page=$page") || return 2
    count=$(printf '%s' "$response" | jq -er 'if type == "array" and all(.[]; (.key | type) == "string") then length else error("invalid key list") end') || return 2
    found=$(printf '%s' "$response" | jq -r --arg key "$key" 'any(.[]; (.key | split(" ") | map(select(length > 0)) | .[0:2] | join(" ")) == $key)') || return 2
    [[ "$found" == true ]] && return 0
    (( count < 100 )) && return 1
  done
  return 2
}
gh_plaintext() {
  local hosts="${XDG_CONFIG_HOME:-$HOME/.config}/gh/hosts.yml"
  [[ -f "$hosts" ]] && grep -Eq '^[[:space:]]+oauth_token:' "$hosts"
}
check_stage() {
  case "$1" in
    agent) agent_ready ;;
    ssh) ssh_ready ;;
    github-cli) gh auth status --hostname github.com >/dev/null 2>&1 && ! gh_plaintext ;;
    codex) codex login status >/dev/null 2>&1 && [[ ! -e "$HOME/.codex/auth.json" ]] ;;
    *) return 1 ;;
  esac
}
apply_stage() {
  case "$1" in
    agent) open -a '1Password' ;;
    ssh)
      pbcopy <"$HOME/.ssh/life-auth.pub"
      open 'https://github.com/settings/ssh/new'
      ;;
    github-cli)
      if gh_plaintext; then gh auth logout --hostname github.com </dev/null; fi
      open 'https://github.com/login/device'
      GH_PROMPT_DISABLED=1 gh auth login --hostname github.com --git-protocol https --web
      if gh_plaintext; then
        gh auth logout --hostname github.com </dev/null || return 1
        printf '%s\n' 'GitHub CLI could not store the login in the keyring; login was removed.' >&2
        return 1
      fi
      ;;
    codex)
      # Replace only the old plaintext credential cache; managed config requires keyring storage.
      rm -f "$HOME/.codex/auth.json"
      codex login
      if [[ -e "$HOME/.codex/auth.json" ]]; then
        printf '%s\n' 'Codex wrote auth.json despite the keyring policy; setup is incomplete.' >&2
        return 1
      fi
      ;;
    *) return 1 ;;
  esac
}

case "${1:-}" in
  --check-ssh-registration) ssh_registration ;;
  --check-stage) check_stage "${2:-}" ;;
  --apply-stage) apply_stage "${2:-}" ;;
  --check)
    missing=()
    for stage in agent ssh github-cli codex; do
      check_stage "$stage" || missing+=("$stage")
    done
    if (( ${#missing[@]} )); then
      printf 'personal authentication needs setup: %s\n' "${missing[*]}"
      exit 1
    fi
    ;;
  *)
    printf '%s\n' 'Run userland sync to complete authentication in the Userland TUI.' >&2
    exit 2
    ;;
esac
