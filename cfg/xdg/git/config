	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINoa9KM7X6vxq/mXeA86sKpOGeszjDOJi8qIhVOVcmxS

[gpg]
	format = ssh

[gpg "ssh"]
	program = ~/.local/bin/userland-git-sign

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[core]
	autocrlf = input
	pager = delta
	attributesfile = ./attributes

[interactive]
	diffFilter = delta --color-only

[fetch]
	prune = true

[pull]
	rebase = true

[merge]
	conflictstyle = zdiff3

[rebase]
	updateRefs = true
	autoSquash = true
	autoStash = true

[rerere]
	enabled = true

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	hyperlinks-file-link-format = "file://{path}:{line}"
	side-by-side = true
	paging = never
	features = catppuccin-mocha

[include]
	path = ./catppuccin.gitconfig

[url "git@life-github:"]
	insteadOf = "https://github.com/"

[url "git@life-github:"]
	insteadOf = "git@github.com:"
