# .zshenv is sourced both in login and interactive shells
# session variables
export XDG_CONFIG_HOME="$HOME/.config"

export EDITOR="zed --wait"
export REACT_EDITOR="zed --wait"

# used to tell lazygit to use delta as pager (https://github.com/jesseduffield/lazygit/blob/master/docs/Custom_Pagers.md#using-git-config)
export GIT_PAGER="delta"

# override the default starship config path
export STARSHIP_CONFIG="$HOME/.config/starship/config.toml"

# set the docker host to the colima socket
export DOCKER_HOST="unix://$HOME/.config/colima/docker.sock"

export ANDROID_HOME="$HOME/Library/Android/sdk"
# Keep stock recovery tools and package managers available without exposing
# project-only mise shims globally.
export PATH="$HOME/.local/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

# Userland generates direct paths for only the tools declared globally. Realm
# activation adds project tools such as gcloud separately through direnv.
if [ -r "${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/mise-env.zsh" ]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/mise-env.zsh"
fi
