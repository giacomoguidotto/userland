#!/bin/sh
set -eu

references="${XDG_CONFIG_HOME:-$HOME/.config}/userland/secret-refs.env"
[ -r "$references" ] || {
  printf 'userland-secrets: create %s with op:// references using userland auth-wizard\n' "$references" >&2
  exit 1
}
command -v op >/dev/null 2>&1 || {
  printf 'userland-secrets: 1Password CLI (op) is unavailable\n' >&2
  exit 1
}
exec op run --env-file="$references" -- "$@"
