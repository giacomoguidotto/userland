# This fragment is sourced from ~/.zshrc. Ignore it for non-interactive shells.
[[ ${-} = ${-/i/} ]] && return

# Keep interactive setup in the conventional startup file. macOS sources its
# global /etc/zshrc after .zshenv, so prompt and completion hooks must be loaded
# here rather than from .zshenv.
if [ -r "${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/mise-env.zsh" ]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/mise-env.zsh"
fi

autoload -Uz compinit
_userland_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/userland/zsh/zcompdump"
if [ -r "$_userland_zcompdump" ]; then
  compinit -C -d "$_userland_zcompdump"
else
  compinit -d "$_userland_zcompdump"
fi
unset _userland_zcompdump

if (( $+commands[fzf] )); then eval "$(fzf --zsh)"; fi
if (( $+commands[atuin] )); then eval "$(atuin init zsh)"; fi
if (( $+commands[zoxide] )); then eval "$(zoxide init zsh)"; fi
if (( $+commands[starship] )); then eval "$(starship init zsh)"; fi
if (( $+commands[mise] )); then eval "$(mise completion zsh)"; fi

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias cl="clear"
alias l="eza -la --icons --git --sort type"
alias lt="l --tree --level=2 --long"
alias la="eza --tree"
alias tp="btop"
alias lz="lazygit"
alias v="nvim"
alias x="exit"
if (( ! ${+aliases[ul]} && ! ${+functions[ul]} )); then
  alias ul=userland
fi

_fselect() { fd "$@" 2>/dev/null | fzf --height 40% --reverse --preview 'rg --context 2 --color always . {} | head -100' --query "${@: -1}"; }
cx() { cd "$@" && l; }
mkcd() { mkdir -p "$1" && cd "$1"; }
klp() { for p in "$@"; do lsof -ti ":$p" | xargs kill -9 2>/dev/null && echo "killed port $p" || echo "no process on port $p"; done; }

bindkey jj vi-cmd-mode
