# 1Password supplies the agent socket on macOS and Linux. Keep the socket in
# SSH_AUTH_SOCK rather than embedding a machine-specific path in this file.
Host life-github
  HostName github.com
  User git
  IdentityFile ~/.ssh/life-auth.pub
  IdentitiesOnly yes

Host nicagi-store01
  HostName nicagi-store01
  User nicagiMaster
  IdentityFile ~/.ssh/life-auth.pub
  IdentitiesOnly yes
